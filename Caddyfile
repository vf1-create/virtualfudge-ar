# Caddy gets + renews the HTTPS certificate automatically (camera access requires HTTPS).
# Set DOMAIN, e.g. ar.yourbrand.com, and point its DNS A record at this server.
{$DOMAIN:localhost} {
	root * /srv
	# Compresses the big engine downloads. Caddy's default type list already covers everything
	# that matters here: the 9.6 MB wasm (application/wasm, shrinks ~70%) and all text files.
	# The face model (.task) is left out on purpose: it's served as a generic binary and only
	# shrinks ~11%, not worth pinning a copy of Caddy's internal type list to capture.
	encode zstd gzip
	file_server

	header {
		Permissions-Policy "camera=(self)"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# no other site may frame the camera page (clickjacking)
		Content-Security-Policy "frame-ancestors 'self'"
	}
	# Engine files: cache for a day (the service worker keeps its own copy). App files: always revalidate.
	@vendor path /vendor/*
	header @vendor Cache-Control "public, max-age=86400"
	@app not path /vendor/*
	header @app Cache-Control "no-cache"

	# branded "page not found"
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
